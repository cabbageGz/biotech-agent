# Copy this file to .env on the server or configure the same values in your
# deployment platform's secret manager. Never commit real keys.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Bailian / DashScope Wanxiang
DASHSCOPE_API_KEY=
WANXIANG_MODEL=wan2.7-image
WANXIANG_IMAGE_SIZE=1024*1024

# Aliyun OSS
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=gzz-agent
ALIYUN_OSS_PUBLIC_BASE_URL=https://gzz-agent.oss-cn-beijing.aliyuncs.com

# Required when using an OSS Access Point endpoint.
ALIYUN_OSS_ACCESS_POINT_ALIAS=
ALIYUN_OSS_SIGNED_URL_EXPIRES=900

# Optional: first admin password only when database/app.db does not exist.
ADMIN_INITIAL_PASSWORD=123456
